# Backend Environment Variables
# Copy this file to .env and fill in the values for local development.
# For Vercel deployment, set these in the Vercel Dashboard:
#   Project Settings → Environment Variables

# Groq API Key (required for vision analysis and chat)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# MongoDB connection string (optional — backend works without it)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/

# Ollama server URL (optional — only used as fallback for local dev)
OLLAMA_URL=http://localhost:11434
